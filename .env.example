# Copia este archivo como .env y cambia los valores
MONGO_ROOT_USER=admin_mongo
MONGO_ROOT_PASSWORD=cambia_esto_root
MONGO_DB=asistencia_en_carretera
# Imagen de MongoDB. Si tu procesador no tiene AVX (MongoDB 5+ se cae con "Illegal instruction"), usa mongo:4.4
MONGO_IMAGE=mongo:8.0
MONGO_APP_USER=taller_app
# Solo letras y numeros (si usas caracteres especiales, escribelos codificados en la URL: @ = %40, : = %3A, / = %2F)
MONGO_APP_PASSWORD=cambia_esto_app
MONGO_HOST_PORT=27017
APP_PORT=8080
TZ=America/Bogota
# Clave para firmar los JWT (32+ caracteres). Genera una con: openssl rand -base64 48
JWT_SECRET=cambia_esto_por_una_clave_larga_de_al_menos_32_caracteres
